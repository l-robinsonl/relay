# ---------------------------------------------------------------------------
# Relay server configuration.
#
# Self-hosting needs nothing in this file beyond RELAY_DATABASE_URL (or
# nothing at all — SQLite is the default) and RELAY_BIND. Everything below
# that is only for the managed Relay Cloud deployment.
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Core (self-hosted and cloud) ------------------------------------------
# sqlite://relay.db  or  postgres://user:pass@host/db?sslmode=require
RELAY_DATABASE_URL=sqlite://data/relay.db
RELAY_BIND=0.0.0.0:8787
# Public origin, used for e-mail links and OAuth redirects.
RELAY_PUBLIC_URL=http://localhost:8787
# 32+ random bytes, base64. Generate: openssl rand -base64 48
RELAY_SECRET_KEY=
# Bootstrap administrator, consumed on first start only.
RELAY_ADMIN_EMAIL=
RELAY_ADMIN_PASSWORD=
# off | invite | open
RELAY_SIGNUP_MODE=invite
RELAY_LOG=info

# --- E-mail (Resend) --------------------------------------------------------
# Optional when self-hosting: without it, verification and invite links are
# written to the server log instead of being e-mailed.
RESEND_API_KEY=
RELAY_MAIL_FROM="Relay <noreply@example.com>"

# --- Relay Cloud only -------------------------------------------------------
# Managed deployment uses Neon Postgres; self-hosting does not need these.
RELAY_DEPLOYMENT_MODE=self_hosted         # self_hosted | cloud
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_ANNUAL=
STRIPE_PORTAL_RETURN_URL=

# ---------------------------------------------------------------------------
# Relay server configuration.
#
# Self-hosting needs nothing in this file beyond RELAY_DATABASE_URL (or
# nothing at all — SQLite is the default) and RELAY_BIND. Everything below
# that is only for the managed Relay Cloud deployment.
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Core (self-hosted and cloud) ------------------------------------------
# sqlite://relay.db  or  postgres://user:pass@host/db?sslmode=require
#
# Quote it if the URL carries query parameters: an unquoted & is a job
# control operator to most shells, and `. .env` will fail on it.
RELAY_DATABASE_URL=sqlite://data/relay.db
RELAY_BIND=0.0.0.0:8787
# Public origin, used for e-mail links and OAuth redirects.
RELAY_PUBLIC_URL=http://localhost:8787
# Bootstrap administrator, consumed on first start only.
RELAY_ADMIN_EMAIL=
RELAY_ADMIN_PASSWORD=
# off | invite | open.
#
# `invite` is the sensible default for a team server: a workspace
# administrator invites an address, and only that address can register,
# using the link they are sent. Bootstrap the first account with
# RELAY_ADMIN_EMAIL / RELAY_ADMIN_PASSWORD below.
RELAY_SIGNUP_MODE=invite
# How long a session lasts before re-authentication.
RELAY_SESSION_DAYS=30
RELAY_LOG=info,sqlx=warn

# --- E-mail (Resend) --------------------------------------------------------
# Optional when self-hosting: without it, verification and reset links are
# written to the server log instead of being e-mailed, which is a perfectly
# good way to run a server for a handful of people you can talk to.
#
# RELAY_RESEND_API_KEY is also accepted, and wins if both are set.
RESEND_API_KEY=
# Must be on a domain verified with Resend, or every send is refused.
RELAY_MAIL_FROM="Relay <noreply@example.com>"
# Refuse sign-in until the address is confirmed. Leave off unless mail is
# actually being delivered, or the first account cannot get in.
RELAY_REQUIRE_VERIFIED_EMAIL=false

# --- The assistant (desktop app) -----------------------------------------
# These are NOT read by the server. The desktop application keeps the
# user's key in the operating system's credential store, set from
# Settings, and sends requests straight to the provider — nothing goes
# through a Relay server, and Relay ships no key of its own.
#
# For development only, the application also falls back to these if the
# keyring has nothing. Leave them blank in production.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Billing ----------------------------------------------------------------
# Leave all of these empty to charge for nothing, which is what
# self-hosting means: no seat is counted, no billing appears anywhere in
# the app, and the three /billing routes refuse.
#
# Set all three of the first ones to charge. All three, deliberately: a
# key with no webhook secret would take payments and never hear that
# they succeeded, which is worse than not charging. The server checks,
# and logs that seats will not be charged if any is missing.
#
#   STRIPE_SECRET_KEY        sk_test_… while testing, sk_live_… in anger
#   STRIPE_WEBHOOK_SECRET    whsec_…, shown when the endpoint is created
#   STRIPE_PRICE_SEAT_ANNUAL price_…, a recurring per-unit price
#
# The webhook endpoint to register in Stripe is
#   https://your-server/v1/billing/webhook
# subscribed to checkout.session.completed and customer.subscription.*.
# Nothing else is acted on, and anything else is acknowledged and
# ignored rather than retried.
#
# RELAY_PUBLIC_URL has to be right: the checkout sends the browser back
# to {RELAY_PUBLIC_URL}/billing/done, and that page is served by this
# server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_ANNUAL=
# Where the customer portal returns to. Defaults to /billing/done.
STRIPE_PORTAL_RETURN_URL=

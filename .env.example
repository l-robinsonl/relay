# ---------------------------------------------------------------------------
# Relay server configuration.
#
# Self-hosting needs nothing in this file beyond RELAY_DATABASE_URL (or
# nothing at all — SQLite is the default) and RELAY_BIND. Everything below
# that is only for the managed Relay Cloud deployment.
#
# Copy to .env and fill in. .env is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Core (self-hosted and cloud) ------------------------------------------
# sqlite://relay.db  or  postgres://user:pass@host/db?sslmode=require
#
# Quote it if the URL carries query parameters: an unquoted & is a job
# control operator to most shells, and `. .env` will fail on it.
RELAY_DATABASE_URL=sqlite://data/relay.db
RELAY_BIND=0.0.0.0:8787
# Public origin, used for e-mail links and OAuth redirects.
RELAY_PUBLIC_URL=http://localhost:8787
# Bootstrap administrator, consumed on first start only.
RELAY_ADMIN_EMAIL=
RELAY_ADMIN_PASSWORD=
# off | invite | open.
#
# `invite` is the sensible default for a team server: a workspace
# administrator invites an address, and only that address can register,
# using the link they are sent. Bootstrap the first account with
# RELAY_ADMIN_EMAIL / RELAY_ADMIN_PASSWORD below.
RELAY_SIGNUP_MODE=invite
# How long a session lasts before re-authentication.
RELAY_SESSION_DAYS=30
RELAY_LOG=info,sqlx=warn

# --- E-mail (Resend) --------------------------------------------------------
# Optional when self-hosting: without it, verification and reset links are
# written to the server log instead of being e-mailed, which is a perfectly
# good way to run a server for a handful of people you can talk to.
#
# RELAY_RESEND_API_KEY is also accepted, and wins if both are set.
RESEND_API_KEY=
# Must be on a domain verified with Resend, or every send is refused.
RELAY_MAIL_FROM="Relay <noreply@example.com>"
# Refuse sign-in until the address is confirmed. Leave off unless mail is
# actually being delivered, or the first account cannot get in.
RELAY_REQUIRE_VERIFIED_EMAIL=false

# --- Relay Cloud only -------------------------------------------------------
# Managed deployment uses Neon Postgres; self-hosting does not need these.
#
# NOT READ YET. Billing is Phase 7 and nothing below is wired up; these are
# here to document the shape, not to be set and relied on.
RELAY_DEPLOYMENT_MODE=self_hosted         # self_hosted | cloud
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_ANNUAL=
STRIPE_PORTAL_RETURN_URL=
